<?php

/**
 * @file
 * Module file for go_back_history.
 *
 * Module for add block to back to previous page.
 */
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\go_back_history\Hook\GoBackHistoryHooks;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function go_back_history_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(GoBackHistoryHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_theme().
 */
#[LegacyHook]
function go_back_history_theme($existing, $type, $theme, $path) {
  return \Drupal::service(GoBackHistoryHooks::class)->theme($existing, $type, $theme, $path);
}
